{
  "version": "2.0",
  "extensionBundle": { "id": "Microsoft.Azure.Functions.ExtensionBundle", "version": "[4.*, 5.0.0)" },
  "extensions": { "eventHubs": { "maxEventBatchSize": 50, "batchCheckpointFrequency": 1 } },
  "retry": { "strategy": "fixedDelay", "maxRetryCount": 3, "delayInterval": "00:00:10" },
  "logging": { "applicationInsights": { "samplingSettings": { "isEnabled": false } } }
}
