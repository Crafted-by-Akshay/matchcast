{
  "permissions": {
    "allow": [
      "Bash(make *)",
      "Bash(npm run *)",
      "Bash(npm ci)",
      "Bash(uv run *)",
      "Bash(uv sync *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git switch*)",
      "Bash(git checkout -b *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)"
    ]
  }
}
