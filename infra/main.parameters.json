{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": { "value": "${AZURE_LOCATION=eastus2}" },
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "foundryProjectEndpoint": { "value": "${FOUNDRY_PROJECT_ENDPOINT}" },
    "foundryAccountName": { "value": "${FOUNDRY_ACCOUNT_NAME=matchcast-foundry}" },
    "entraClientId": { "value": "${ENTRA_CLIENT_ID=}" },
    "alertEmail": { "value": "${ALERT_EMAIL=}" },
    "apiImage": { "value": "${API_IMAGE=mcr.microsoft.com/k8se/quickstart:latest}" },
    "webImage": { "value": "${WEB_IMAGE=mcr.microsoft.com/k8se/quickstart:latest}" },
    "searchKeysInVault": { "value": "${SEARCH_KEYS_IN_VAULT=false}" },
    "pipelineMode": { "value": "${PIPELINE_MODE=direct}" },
    "keepWarm": { "value": "${KEEP_WARM=false}" },
    "agentMode": { "value": "${AGENT_MODE=rules}" },
    "foundryModelDeployment": { "value": "${FOUNDRY_MODEL_DEPLOYMENT=gpt-5-mini}" },
    "mcpImage": { "value": "${MCP_IMAGE=mcr.microsoft.com/k8se/quickstart:latest}" }
  }
}
