{
  "name": "matchcast",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "workspaces": [
    "apps/*",
    "packages/contracts"
  ],
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspace @matchcast/contracts && npm run build --workspace apps/broadcast-web"
  }
}
