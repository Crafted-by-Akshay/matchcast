{
  "name": "matchcast",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "workspaces": [
    "apps/*",
    "packages/contracts"
  ],
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspace @matchcast/contracts && npm run build --workspace apps/broadcast-web",
    "e2e": "playwright test --project=chromium",
    "e2e-webkit": "playwright test --project=webkit",
    "e2e-live": "playwright test --project=chromium --grep @live"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.56.1",
    "three": "0.160.0"
  }
}
